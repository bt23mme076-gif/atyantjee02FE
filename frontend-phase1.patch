@@ -0,0 +1,69 @@
+import React from 'react';
+import { PlayCircle, FileText, ClipboardCheck, HelpCircle, CheckCircle2, Circle, Lock } from 'lucide-react';
+
+const typeIconMap = {
+  video: PlayCircle,
+  document: FileText,
+  article: FileText,
+  task: ClipboardCheck,
+  quiz: HelpCircle,
+};
+
+// A single video/document/task row inside a pillar section. Logged-out
+// visitors see everything but content is locked; logged-in students can
+// mark items complete which drives the streak + progress bar.
+export default function RoadmapItemCard({ item, isLoggedIn, isCompleted, onComplete, isSaving }) {
+  const TypeIcon = typeIconMap[item.type] || FileText;
+
+  return (
+    <div
+      className={`flex items-center justify-between gap-4 rounded-2xl border px-5 py-4 transition ${
+        isCompleted
+          ? 'border-emerald-400/30 bg-emerald-500/5'
+          : 'border-white/10 bg-white/[0.03] hover:border-white/20'
+      }`}
+    >
+      <div className="flex items-center gap-3 min-w-0">
+        <div
+          className={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ${
+            isCompleted ? 'bg-emerald-500/15 text-emerald-400' : 'bg-white/5 text-[#FF9E6B]'
+          }`}
+        >
+          <TypeIcon className="h-5 w-5" />
+        </div>
+        <div className="min-w-0">
+          <p className="truncate text-sm font-semibold text-white">{item.title}</p>
+          <p className="text-xs text-white/45">
+            {item.type.charAt(0).toUpperCase() + item.type.slice(1)}
+            {item.durationLabel ? ` · ${item.durationLabel}` : ''}
+          </p>
+        </div>
+      </div>
+
+      {!isLoggedIn ? (
+        <Lock className="h-4 w-4 shrink-0 text-white/30" />
+      ) : (
+        <button
+          type="button"
+          disabled={isCompleted || isSaving}
+          onClick={() => onComplete && onComplete(item.id)}
+          className={`flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold transition ${
+            isCompleted
+              ? 'cursor-default bg-emerald-500/15 text-emerald-400'
+              : 'bg-white/10 text-white hover:bg-[#FF6B2B] hover:text-white disabled:opacity-50'
+          }`}
+        >
+          {isCompleted ? (
+            <>
+              <CheckCircle2 className="h-3.5 w-3.5" /> Done
+            </>
+          ) : (
+            <>
+              <Circle className="h-3.5 w-3.5" /> {isSaving ? 'Saving…' : 'Mark complete'}
+            </>
+          )}
+        </button>
+      )}
+    </div>
+  );
+}
