+import React from 'react';
+import { motion } from 'framer-motion';
+import { ArrowRight } from 'lucide-react';
+
+// Pastel dot colors keyed by the backend's `colorKey`, matching the
+// "29 career paths" reference design's varied circle avatars.
+const dotColorMap = {
+  rose: 'bg-rose-200',
+  violet: 'bg-violet-200',
+  emerald: 'bg-emerald-200',
+  amber: 'bg-amber-200',
+  sky: 'bg-sky-200',
+};
+
+function CareerPathCard({ path, onSelect }) {
+  return (
+    <motion.button
+      type="button"
+      onClick={() => onSelect(path)}
+      whileHover={{ y: -2 }}
+      className="flex items-center justify-between gap-3 rounded-2xl border border-[#0B0F2E]/10 bg-white px-5 py-4 text-left shadow-sm transition hover:border-[#FF6B2B]/40 hover:shadow-md"
+    >
+      <div className="flex min-w-0 items-center gap-3">
+        <span className={`h-9 w-9 shrink-0 rounded-full ${dotColorMap[path.colorKey] || 'bg-rose-200'}`} />
+        <span className="truncate text-sm font-semibold text-[#0B0F2E]">{path.title}</span>
+      </div>
+      <ArrowRight className="h-4 w-4 shrink-0 text-[#0B0F2E]/40" />
+    </motion.button>
+  );
+}
+
+// "29 career paths. One platform." grid — deliberately light/cream to match
+// the roadmap design reference, distinct from the dark navy pillar section
+// it sits below on /roadmap.
+export default function CareerPathsSection({ featured = [], totalCount = 0, remainingCount = 0 }) {
+  const handleSelect = () => {
+    // No dedicated per-path page yet — reuse the site's existing lead
+    // capture flow so interest here still reaches the team.
+    window.dispatchEvent(new CustomEvent('openLeadModal'));
+  };
+
+  if (!featured.length) return null;
+
+  return (
+    <section className="bg-[#FFF8F0] py-16 sm:py-20">
+      <div className="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
+        <div className="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
+          <div>
+            <p className="text-sm font-bold uppercase tracking-wide text-[#FF6B2B]">Career Exploration</p>
+            <h2 className="mt-2 max-w-xl text-3xl font-black leading-tight text-[#0B0F2E] sm:text-4xl">
+              {totalCount || featured.length} career paths. One platform.
+            </h2>
+            <p className="mt-3 max-w-lg text-[#0B0F2E]/60">
+              From Software Engineering to MBA prep — explore every direction available to you.
+            </p>
+          </div>
+          <button
+            type="button"
+            onClick={handleSelect}
+            className="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-full border border-[#0B0F2E] px-6 py-3 text-sm font-semibold text-[#0B0F2E] transition hover:bg-[#0B0F2E] hover:text-white sm:self-auto"
+          >
+            Take the Career Fit Quiz <ArrowRight className="h-4 w-4" />
+          </button>
+        </div>
+
+        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
+          {featured.map((path) => (
+            <CareerPathCard key={path.id} path={path} onSelect={handleSelect} />
+          ))}
+        </div>
+
+        {remainingCount > 0 && (
+          <p className="mt-6 text-sm text-[#0B0F2E]/50">
+            + {remainingCount} more paths inside the platform.
+          </p>
+        )}
+      </div>
+    </section>
+  );
+}
