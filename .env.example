# Atyant Launchpad Frontend Environment Variables
# Copy this file to .env and fill in real values.

# Backend API base URL.
# - Local dev against a local backend: http://localhost:5000
# - Local dev against the deployed backend: https://api.atyant.in
VITE_API_URL=http://localhost:5000

# Public HTTPS origin of THIS frontend app. Used to build Cashfree's
# return_url. Cashfree requires this to be HTTPS — it will reject order
# creation with "order_meta.return_url : url should be https" if this is
# unset and the app happens to be running on http://localhost.
VITE_APP_URL=https://jee.atyant.in

# Google OAuth Client ID (Get this from Google Cloud Console under APIs & Services > Credentials)
# Paste your real Google OAuth Client ID below to enable "Sign in with Google" on the login/signup page.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here.apps.googleusercontent.com

# Google Analytics (GA4) measurement ID. (Optional, e.g. G-XXXXXXXXXX)
# If provided, GA4 tracking scripts will be initialized on application start.
VITE_GA_ID=
